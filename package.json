{
	"name": "typst-js",
	"private": true,
	"description": "The workspace of @jsfi/typst-wasm (built into pkg/ by build.sh), @jsfi/typst-cli and @jsfi/typst-fields (packages/)",
	"license": "Apache-2.0",
	"workspaces": [
		"packages/typst-cli",
		"packages/typst-fields"
	],
	"type": "module",
	"scripts": {
		"build": "./build.sh",
		"test": "npm test --workspace @jsfi/typst-cli --workspace @jsfi/typst-fields && node --test 'examples/**/*.test.mjs'",
		"example": "node examples/browser/serve.mjs",
		"bench": "node benchmarks/pdf.mjs",
		"format": "vp fmt && scripts/cargo.sh fmt",
		"format:check": "vp fmt --check && scripts/cargo.sh fmt --check",
		"lint": "vp lint"
	},
	"devDependencies": {
		"@jsfi/typst-wasm": "file:pkg",
		"vite-plus": "1.0.0-rc.1"
	}
}
